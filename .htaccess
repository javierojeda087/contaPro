<IfModule mod_rewrite.c>
    RewriteEngine On

    # Permitir siempre validación automática de certificados SSL en cPanel (AutoSSL / Let's Encrypt)
    RewriteRule ^\.well-known/ - [L]

    # Forzar HTTPS en producción (ignorar localhost y 127.0.0.1)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bloquear acceso directo por navegador a carpetas internas del sistema
    RewriteRule ^(config|core|app|database)/ - [F,L]

    # Permitir acceso directo a archivos y carpetas estáticas existentes (css, js, images, .well-known)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todas las rutas al Front Controller index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Garantizar que cualquier recurso se cargue bajo HTTPS y reforzar seguridad
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Impedir listado de directorios en cPanel
Options -Indexes

# Proteger archivos sensibles (.sql, .env, .md, etc.) compatible con Apache 2.2 y 2.4
<FilesMatch "\.(sql|key|p12|env|md|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

