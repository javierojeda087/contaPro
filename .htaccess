<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirigir www y HTTP hacia https://contapro.com.py (excepto validación SSL /.well-known/)
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://contapro.com.py%{REQUEST_URI} [L,R=301]

    # Bloquear acceso directo por navegador a carpetas internas del sistema
    RewriteRule ^(config|core|app/(Controllers|Models|Services|Helpers)|database)/ - [F,L]

    # Permitir acceso directo a archivos y carpetas estáticas existentes (css, js, images, .well-known)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todas las rutas al Front Controller index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Garantizar que cualquier recurso se cargue bajo HTTPS y reforzar seguridad
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Impedir listado de directorios en cPanel
Options -Indexes

# Proteger archivos sensibles (.sql, .zip, .bat, .env, .md, .ini, etc.) compatible con Apache 2.2 y 2.4
<FilesMatch "(\.(sql|key|p12|env|md|sh|bak|zip|bat|yml|yaml|log|ini)|^\.user\.ini|php\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Mitigación de emergencia contra PHP2Shell (CVE-2026-109618 / CVE-2026-109619) para mod_php / lsapi
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 16M
    php_value upload_max_filesize 16M
    php_value memory_limit 256M
</IfModule>
<IfModule lsapi_module>
    php_flag session.upload_progress.enabled Off
    php_value post_max_size 16M
    php_value upload_max_filesize 16M
    php_value memory_limit 256M
</IfModule>

